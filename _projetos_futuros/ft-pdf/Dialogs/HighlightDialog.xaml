<Window x:Class="FtPdf.Dialogs.HighlightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marca-texto e Destaque"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto" />
            <!-- Form Content -->
            <RowDefinition Height="*" />
            <!-- Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🖍️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Destaque / Marca-Texto" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Aplique uma camada de marca-texto semitransparente na página selecionada." 
                       FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <!-- Page Number -->
            <TextBlock Text="Página Alvo:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
            <TextBox x:Name="TxtPageNumber" Text="1" Background="#1E293B" Foreground="#F8FAFC" 
                     BorderBrush="#334155" Padding="6" FontSize="12" Margin="0,0,0,12" />

            <!-- Region -->
            <TextBlock Text="Região de Destaque:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
            <ComboBox x:Name="ComboRegion" SelectedIndex="0" Background="#1E293B" Foreground="#F8FAFC" Padding="6" Margin="0,0,0,12">
                <ComboBoxItem Content="Cabeçalho / Título (Topo da página)" />
                <ComboBoxItem Content="Parágrafo Central" />
                <ComboBoxItem Content="Área de Totais / Rodapé" />
            </ComboBox>

            <!-- Color -->
            <TextBlock Text="Cor do Marca-Texto:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
            <ComboBox x:Name="ComboColor" SelectedIndex="0" Background="#1E293B" Foreground="#F8FAFC" Padding="6">
                <ComboBoxItem Content="🟡 Amarelo Fluorescente" />
                <ComboBoxItem Content="🟢 Verde Claro" />
                <ComboBoxItem Content="🌸 Rosa / Magenta" />
                <ComboBoxItem Content="🔵 Azul Claro" />
            </ComboBox>
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Click="BtnCancel_Click"
                    Background="#334155" Foreground="#F8FAFC" FontWeight="Medium"
                    Padding="16,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>
            
            <Button Content="Aplicar Destaque" Click="BtnConfirm_Click"
                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                    Padding="18,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
