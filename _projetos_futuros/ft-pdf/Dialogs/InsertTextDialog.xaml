<Window x:Class="FtPdf.Dialogs.InsertTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inserir Texto no Documento"
        Height="460" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto" />
            <!-- Form Content -->
            <RowDefinition Height="*" />
            <!-- Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✍️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Inserir Texto / Anotação" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Digite o texto que deseja estampar diretamente na página do PDF." 
                       FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <!-- Text Content -->
            <TextBlock Text="Texto a Inserir:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
            <TextBox x:Name="TxtInputText" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8"
                     FontFamily="Consolas, Segoe UI" FontSize="12.5" Margin="0,0,0,12" />

            <!-- Page Selection -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Página Alvo:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtPageNumber" Text="1" Background="#1E293B" Foreground="#F8FAFC" 
                             BorderBrush="#334155" Padding="6" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Tamanho da Fonte:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
                    <ComboBox x:Name="ComboFontSize" SelectedIndex="1" Background="#1E293B" Foreground="#F8FAFC" Padding="6">
                        <ComboBoxItem Content="10 pt" />
                        <ComboBoxItem Content="14 pt" />
                        <ComboBoxItem Content="18 pt" />
                        <ComboBoxItem Content="24 pt" />
                        <ComboBoxItem Content="32 pt" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Position & Color -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Posicionamento:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
                    <ComboBox x:Name="ComboPosition" SelectedIndex="0" Background="#1E293B" Foreground="#F8FAFC" Padding="6">
                        <ComboBoxItem Content="Cabeçalho (Topo)" />
                        <ComboBoxItem Content="Rodapé (Base)" />
                        <ComboBoxItem Content="Centro da Página" />
                        <ComboBoxItem Content="Inferior Direito" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Cor do Texto:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
                    <ComboBox x:Name="ComboColor" SelectedIndex="0" Background="#1E293B" Foreground="#F8FAFC" Padding="6">
                        <ComboBoxItem Content="Preto" />
                        <ComboBoxItem Content="Azul" />
                        <ComboBoxItem Content="Vermelho" />
                        <ComboBoxItem Content="Verde" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Click="BtnCancel_Click"
                    Background="#334155" Foreground="#F8FAFC" FontWeight="Medium"
                    Padding="16,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>
            
            <Button Content="Inserir no PDF" Click="BtnConfirm_Click"
                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                    Padding="18,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
