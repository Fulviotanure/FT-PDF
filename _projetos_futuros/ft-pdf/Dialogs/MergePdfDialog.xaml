<Window x:Class="FtPdf.Dialogs.MergePdfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesclar Arquivos PDF"
        Height="500" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto" />
            <!-- Content List -->
            <RowDefinition Height="*" />
            <!-- Actions -->
            <RowDefinition Height="Auto" />
            <!-- Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📑" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Mesclar Documentos PDF" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Selecione e organize a ordem dos arquivos PDF para combiná-los em um único arquivo." 
                       FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Files List -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,10">
            <ListBox x:Name="ListPdfs" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                     FontSize="12" SelectionMode="Single" />
        </Border>

        <!-- List Actions -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="➕ Adicionar PDF" Click="BtnAddFile_Click"
                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                    Padding="12,6" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="▲ Subir" Click="BtnMoveUp_Click"
                        Background="#334155" Foreground="#F8FAFC" FontSize="11.5"
                        Padding="10,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style></Button.Resources>
                </Button>

                <Button Content="▼ Descer" Click="BtnMoveDown_Click"
                        Background="#334155" Foreground="#F8FAFC" FontSize="11.5"
                        Padding="10,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style></Button.Resources>
                </Button>

                <Button Content="🗑️ Remover" Click="BtnRemove_Click"
                        Background="#EF4444" Foreground="White" FontSize="11.5"
                        Padding="10,6" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="BtnCancel_Click"
                    Background="#334155" Foreground="#F8FAFC" FontWeight="Medium"
                    Padding="16,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>
            
            <Button Content="Mesclar e Salvar..." Click="BtnConfirm_Click"
                    Background="#10B981" Foreground="White" FontWeight="SemiBold"
                    Padding="18,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
