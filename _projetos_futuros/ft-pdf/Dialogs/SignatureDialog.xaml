<Window x:Class="FtPdf.Dialogs.SignatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assinatura Digital no PDF"
        Height="580" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto" />
            <!-- Tab Content -->
            <RowDefinition Height="*" />
            <!-- Position & Page -->
            <RowDefinition Height="Auto" />
            <!-- Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🖋️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Assinar Documento PDF" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Desenhe sua assinatura ou carregue uma imagem de rubrica para estampar no PDF." 
                       FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Signature Options TabControl -->
        <TabControl Grid.Row="1" Background="#1E293B" BorderBrush="#334155" Margin="0,0,0,16">
            <!-- Draw Signature Tab -->
            <TabItem Header="✍️ Desenhar Assinatura">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                        <InkCanvas x:Name="CanvasSignature" Background="White" MinHeight="160" />
                    </Border>

                    <Button Grid.Row="1" Content="Limpar Assinatura" Click="BtnClearCanvas_Click"
                            HorizontalAlignment="Right" Background="#334155" Foreground="#CBD5E1"
                            FontSize="11.5" Padding="12,5" Margin="0,8,0,0" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style></Button.Resources>
                    </Button>
                </Grid>
            </TabItem>

            <!-- Upload Image Tab -->
            <TabItem Header="🖼️ Carregar Imagem">
                <StackPanel Margin="12" VerticalAlignment="Center">
                    <Button Content="Selecionar Imagem (PNG/JPG)" Click="BtnUploadImage_Click"
                            Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                            Padding="16,10" HorizontalAlignment="Center" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                    </Button>

                    <TextBlock x:Name="TxtSelectedImage" Text="Nenhuma imagem selecionada" 
                               FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Position & Page Selection -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Página Alvo:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
                <TextBox x:Name="TxtPageNumber" Text="1" Background="#1E293B" Foreground="#F8FAFC" 
                         BorderBrush="#334155" Padding="6" FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Posicionamento:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
                <ComboBox x:Name="ComboPosition" SelectedIndex="0" Background="#1E293B" Foreground="#F8FAFC" Padding="6">
                    <ComboBoxItem Content="Inferior Direito (Padrão)" />
                    <ComboBoxItem Content="Inferior Esquerdo" />
                    <ComboBoxItem Content="Centro da Página" />
                    <ComboBoxItem Content="Rodapé Central" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="BtnCancel_Click"
                    Background="#334155" Foreground="#F8FAFC" FontWeight="Medium"
                    Padding="16,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>
            
            <Button Content="Aplicar Assinatura" Click="BtnConfirm_Click"
                    Background="#10B981" Foreground="White" FontWeight="SemiBold"
                    Padding="18,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
