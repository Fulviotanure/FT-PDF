<Window x:Class="FtPdf.Dialogs.SplitPdfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dividir / Extrair Páginas"
        Height="400" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto" />
            <!-- Form -->
            <RowDefinition Height="*" />
            <!-- Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✂️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Extrair / Dividir Páginas" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Selecione as páginas que deseja extrair para um novo arquivo PDF." 
                       FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Form Content -->
        <StackPanel Grid.Row="1">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="TxtDocumentInfo" Text="Total de Páginas: 1" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" />
                    <TextBlock Text="Exemplo de intervalos válidos: 1-3, 5, 7-10" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Intervalo de Páginas a Extrair:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
            <TextBox x:Name="TxtPageRange" Text="1" Background="#1E293B" Foreground="#F8FAFC" 
                     BorderBrush="#334155" Padding="8" FontSize="13" Margin="0,0,0,12" />
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="BtnCancel_Click"
                    Background="#334155" Foreground="#F8FAFC" FontWeight="Medium"
                    Padding="16,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>
            
            <Button Content="Extrair e Salvar..." Click="BtnConfirm_Click"
                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                    Padding="18,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
