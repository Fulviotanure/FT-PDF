<Window x:Class="FtPdf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FT PDF"
        Icon="Assets/logo.png"
        Height="860" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" 
                      ResizeBorderThickness="6" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}" />
    </Window.InputBindings>

    <Grid Background="#0F172A">
        <Grid.RowDefinitions>
            <!-- Integrated Custom Titlebar with Tabs (Height: 38) -->
            <RowDefinition Height="38" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== CUSTOM INTEGRATED TITLEBAR ==================== -->
        <Border Grid.Row="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                AllowDrop="True" Drop="TabsBar_Drop" DragOver="TabsBar_DragOver">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Brand Logo -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Center: Integrated Tabs Strip -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Custom Window Controls (Min, Max, Close) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Branding with Official Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,8,0"
                            Background="Transparent">
                    <Image Source="Assets/logo.png" Width="20" Height="20" Margin="0,0,8,0" 
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="FT PDF" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,10,0" />
                </StackPanel>

                <!-- Center: Seamless Adaptive Document Tabs Strip -->
                <ScrollViewer x:Name="ScrollTabs" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center" Background="Transparent"
                              PreviewMouseLeftButtonDown="ScrollViewer_PreviewMouseLeftButtonDown"
                              SizeChanged="ScrollTabs_SizeChanged"
                              WindowChrome.IsHitTestVisibleInChrome="True"
                              AllowDrop="True"
                              Drop="TabsBar_Drop"
                              DragOver="TabsBar_DragOver">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <!-- Dynamic Document Tabs -->
                        <StackPanel x:Name="PanelTabs" Orientation="Horizontal" VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />

                        <!-- Add Tab Button -->
                        <Button x:Name="BtnNewTab" Content="➕ Nova Aba" Click="BtnOpenFile_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Background="Transparent" Foreground="#64748B" FontSize="11.5" FontWeight="Medium"
                                Padding="8,4" Margin="4,0,0,0" BorderThickness="0" Cursor="Hand"
                                ToolTip="Abrir outro documento PDF em uma nova aba">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: Custom Integrated Window Controls (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize Button -->
                    <Button x:Name="BtnMinimize" Content="🗕" Click="BtnMinimize_Click"
                            Width="44" Background="Transparent" Foreground="#94A3B8" FontSize="12"
                            BorderThickness="0" Cursor="Hand" ToolTip="Minimizar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1E293B" />
                                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximize / Restore Button -->
                    <Button x:Name="BtnMaximize" Content="🗖" Click="BtnMaximize_Click"
                            Width="44" Background="Transparent" Foreground="#94A3B8" FontSize="12"
                            BorderThickness="0" Cursor="Hand" ToolTip="Maximizar / Restaurar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1E293B" />
                                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="BtnCloseWindow" Content="✕" Click="BtnCloseWindow_Click"
                            Width="46" Background="Transparent" Foreground="#94A3B8" FontSize="13"
                            BorderThickness="0" Cursor="Hand" ToolTip="Fechar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E11D48" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT ROW ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Left Sidebar: Core Actions (Width: 60) -->
                <ColumnDefinition Width="60" />
                <!-- Column 1: Page Navigator Sidebar (Width: 0 or 230) -->
                <ColumnDefinition x:Name="ColPageSidebar" Width="0" />
                <!-- Column 2: Center: Native Vector Document Viewer Area -->
                <ColumnDefinition Width="*" MinWidth="350" />
                <!-- Column 3: Splitter for Validation Panel -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 4: Right: Validation & Notepad Panel -->
                <ColumnDefinition x:Name="ColNotepad" Width="0" MaxWidth="900" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT SIDEBAR WITH ALL BUTTONS ==================== -->
            <Border Grid.Column="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <Grid Margin="0,8">
                    <Grid.RowDefinitions>
                        <!-- Top tools: Open, Save, Copy, Validate -->
                        <RowDefinition Height="Auto" />
                        <!-- Middle tools: Edit tools -->
                        <RowDefinition Height="*" />
                        <!-- Bottom tool: Settings -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Group 1: Core Document Actions -->
                    <StackPanel Grid.Row="0">
                        <!-- Open File -->
                        <Button x:Name="BtnOpenFile" Content="📂" ToolTip="Abrir Arquivo PDF (Ctrl+O)" Click="BtnOpenFile_Click"
                                Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#38BDF8" 
                                FontSize="18" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>

                        <!-- Quick Save -->
                        <Button x:Name="BtnQuickSave" Content="💾" ToolTip="Salvar Cópia do PDF (Ctrl+S)" Click="BtnQuickSave_Click"
                                Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#34D399" 
                                FontSize="18" BorderThickness="0" Cursor="Hand" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>

                        <!-- Quick Copy -->
                        <Button x:Name="BtnQuickCopy" Content="📋" ToolTip="Copiar Texto Formatado" Click="BtnQuickCopy_Click"
                                Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#A78BFA" 
                                FontSize="18" BorderThickness="0" Cursor="Hand" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>

                        <!-- Validate / Diagnostics -->
                        <Button x:Name="BtnToggleNotepad" Content="🔍" ToolTip="Validar Integridade e Bloco de Notas" Click="BtnToggleNotepad_Click"
                                Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#FACC15" 
                                FontSize="18" BorderThickness="0" Cursor="Hand" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>

                        <!-- Page Navigator Sidebar Button -->
                        <Button x:Name="BtnTogglePages" Content="📑" ToolTip="Visualizador de Páginas Lateral" Click="BtnTogglePages_Click"
                                Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#38BDF8" 
                                FontSize="18" BorderThickness="0" Cursor="Hand" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#1E293B" Margin="8,4,8,8" />
                    </StackPanel>

                    <!-- Group 2: PDF Editing & Manipulation Tools -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Inserir Texto Tool -->
                            <Button x:Name="BtnToolText" Content="✍️" ToolTip="Inserir Texto no PDF" Click="BtnToolText_Click"
                                    Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#F8FAFC" 
                                    FontSize="17" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                </Button.Resources>
                            </Button>

                            <!-- Marcador Destaque Tool -->
                            <Button x:Name="BtnToolHighlight" Content="🖍️" ToolTip="Marca-Texto / Destaque" Click="BtnToolHighlight_Click"
                                    Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#F8FAFC" 
                                    FontSize="17" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                </Button.Resources>
                            </Button>

                            <!-- Assinatura Tool -->
                            <Button x:Name="BtnToolSignature" Content="🖋️" ToolTip="Assinatura Digital / Rubrica" Click="BtnToolSignature_Click"
                                    Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#F8FAFC" 
                                    FontSize="17" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                </Button.Resources>
                            </Button>

                            <!-- Dividir / Extrair Tool -->
                            <Button Content="✂️" ToolTip="Dividir / Extrair Páginas" Click="BtnToolSplit_Click"
                                    Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#F8FAFC" 
                                    FontSize="17" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                </Button.Resources>
                            </Button>

                            <!-- Mesclar PDFs Tool -->
                            <Button Content="📑" ToolTip="Mesclar Arquivos PDF" Click="BtnToolMerge_Click"
                                    Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#F8FAFC" 
                                    FontSize="17" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                </Button.Resources>
                            </Button>

                            <!-- Girar Página Tool -->
                            <Button Content="🔄" ToolTip="Girar Página em 90°" Click="BtnToolRotate_Click"
                                    Width="44" Height="44" Margin="0,0,0,6" Background="#1E293B" Foreground="#F8FAFC" 
                                    FontSize="17" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Group 3: Settings (At Bottom) -->
                    <StackPanel Grid.Row="2">
                        <Rectangle Height="1" Fill="#1E293B" Margin="8,4,8,8" />
                        <Button x:Name="BtnSettings" Content="⚙️" ToolTip="Configurações (Programa Padrão e Atualizações)" Click="BtnSettings_Click"
                                Width="44" Height="44" Background="#1E293B" Foreground="#94A3B8" 
                                FontSize="18" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== COLUMN 1: PAGE NAVIGATOR SIDEBAR ==================== -->
            <Border Grid.Column="1" x:Name="PanelPageSidebar" Background="#0A0F1D" 
                    BorderBrush="#1E293B" BorderThickness="0,0,1,0" Visibility="Collapsed">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <!-- Header: Title + Page Count + Close Button -->
                        <RowDefinition Height="Auto" />
                        <!-- Scrollable Pages List (Thumbnails) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📑" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="PÁGINAS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPageCountBadge" Text="0 pág." FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="◀" ToolTip="Recolher painel de páginas" Click="BtnClosePageSidebar_Click"
                                Width="24" Height="24" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" FontSize="10">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Page Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PanelPageCards" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ==================== COLUMN 2: CENTER VIEWER & EMPTY STATE & SPLIT SCREEN ==================== -->
            <Grid Grid.Column="2" x:Name="CenterDocumentContainer" Background="#0F172A">
                <!-- Empty State (When no documents are open) -->
                <Grid x:Name="PanelEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel MaxWidth="460" HorizontalAlignment="Center">
                        <Border Width="88" Height="88" CornerRadius="22" Background="#131D31" 
                                BorderBrush="#334155" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Image Source="Assets/logo.png" Width="74" Height="74" 
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <TextBlock Text="Nenhum documento aberto" FontSize="19" FontWeight="Bold" 
                                   Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        
                        <TextBlock Text="Abra um arquivo PDF pelo botão na barra lateral ou selecione abaixo para iniciar a leitura vetorial nativa e edição." 
                                   Foreground="#94A3B8" FontSize="13" TextAlignment="Center" 
                                   TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,22" />

                        <Button Content="Selecionar Arquivo PDF" Click="BtnOpenFile_Click"
                                Background="#3B82F6" Foreground="White" FontSize="13.5" FontWeight="SemiBold"
                                Padding="18,10" HorizontalAlignment="Center" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Active Vector Viewer Area (Supports Single View and Split Screen) -->
                <Grid x:Name="PanelActiveContent" Visibility="Collapsed" AllowDrop="True" Drop="ViewerArea_Drop" DragOver="ViewerArea_DragOver">
                    <Grid.ColumnDefinitions>
                        <!-- Primary Viewer (Left Screen) -->
                        <ColumnDefinition x:Name="ColPrimaryViewer" Width="*" />
                        <!-- Split Screen Splitter -->
                        <ColumnDefinition x:Name="ColSplitSplitter" Width="Auto" />
                        <!-- Secondary Viewer (Right Screen) -->
                        <ColumnDefinition x:Name="ColSecondaryViewer" Width="0" />
                    </Grid.ColumnDefinitions>

                    <!-- Primary Document Viewer (Native Pdfium) -->
                    <Grid Grid.Column="0" Background="#0F172A">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Zoom Control Bar -->
                        <Border Grid.Row="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Page indicator (left) -->
                                <TextBlock x:Name="TxtViewerPageInfo" Grid.Column="0"
                                           Text="" FontSize="11" Foreground="#64748B"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                <!-- Zoom controls (center) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnZoomOut" Content="−" Click="BtnZoomOut_Click"
                                            Width="26" Height="24" Background="#1E293B" Foreground="#F8FAFC"
                                            FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Reduzir zoom (Ctrl+-)">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <TextBlock x:Name="TxtZoomLevel" Text="100%"
                                               Width="54" TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0"/>
                                    <Button x:Name="BtnZoomIn" Content="+" Click="BtnZoomIn_Click"
                                            Width="26" Height="24" Background="#1E293B" Foreground="#F8FAFC"
                                            FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Aumentar zoom (Ctrl++)">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="BtnZoomFit" Content="⊞ Ajustar" Click="BtnZoomFit_Click"
                                            Height="24" Padding="8,0" Margin="8,0,0,0"
                                            Background="#1E293B" Foreground="#38BDF8"
                                            FontSize="11" FontWeight="Medium" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Ajustar à largura">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Pages ScrollViewer -->
                        <ScrollViewer x:Name="PdfScrollViewer" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Background="#13182B"
                                      PreviewMouseWheel="PdfScrollViewer_PreviewMouseWheel"
                                      ScrollChanged="PdfScrollViewer_ScrollChanged">
                            <StackPanel x:Name="PdfPagesPanel"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,16"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- Splitter between Primary and Secondary Screen -->
                    <GridSplitter Grid.Column="1" x:Name="SplitViewSplitter" Width="5" 
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="#1E293B" Cursor="SizeWE" Visibility="Collapsed" />

                    <!-- Secondary Document Viewer (Split Screen) -->
                    <Grid Grid.Column="2" x:Name="PanelSplitViewer" Visibility="Collapsed" Background="#0A0F1D">
                        <Grid.RowDefinitions>
                            <!-- Split Screen Header with Tab Title, Unir Aba and Close -->
                            <RowDefinition Height="36" />
                            <!-- Split WebView2 -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Split Header Bar (draggable back to tabs!) -->
                        <Border Grid.Row="0" Background="#131D31" BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                                x:Name="SplitHeaderBar" 
                                PreviewMouseLeftButtonDown="SplitHeaderBar_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="SplitHeaderBar_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="SplitHeaderBar_PreviewMouseLeftButtonUp"
                                Cursor="Hand" ToolTip="Arraste de volta para a barra superior ou clique em Unir Aba">
                            <Grid Margin="10,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Icon + File Name -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtSplitFileName" Text="Documento Dividido.pdf" FontSize="11.5" 
                                               FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" 
                                               MaxWidth="240" VerticalAlignment="Center" />
                                    <Border Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" 
                                            CornerRadius="4" Padding="5,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="TELA DIVIDIDA" FontSize="8.5" FontWeight="Bold" Foreground="#93C5FD" />
                                    </Border>
                                </StackPanel>

                                <!-- Right: Action Buttons (Unir Aba, Fechar Split) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Unir em Aba Button -->
                                    <Button x:Name="BtnMergeSplitTab" Content="⤢ Unir Aba" Click="BtnMergeSplitTab_Click"
                                            Background="#1E293B" Foreground="#38BDF8" FontSize="11" FontWeight="Medium"
                                            Padding="8,3" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Unir este documento de volta como uma aba normal">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Close Split Screen Button -->
                                    <Button x:Name="BtnCloseSplitTab" Content="✕" Click="BtnCloseSplitTab_Click"
                                            Width="24" Height="24" Background="Transparent" Foreground="#94A3B8" 
                                            FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Fechar tela dividida">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Split Native Viewer (Pdfium) -->
                        <ScrollViewer x:Name="SplitPdfScrollViewer" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Background="#13182B"
                                      PreviewMouseWheel="SplitScrollViewer_PreviewMouseWheel">
                            <StackPanel x:Name="SplitPdfPagesPanel"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,16"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Drag & Drop Split Screen Visual Drop Zone Overlay -->
                <Border x:Name="OverlaySplitDropZone" Background="#EB0A0F1D" 
                        BorderBrush="#38BDF8" BorderThickness="2"
                        CornerRadius="14" Margin="16" Visibility="Collapsed"
                        AllowDrop="True" Drop="SplitDropZone_Drop" DragOver="SplitDropZone_DragOver">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="68" Height="68" CornerRadius="18" Background="#1E293B" 
                                BorderBrush="#38BDF8" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="⬌" FontSize="34" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Solte aqui para dividir a tela em duas" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                        <TextBlock Text="Arraste para o topo para manter como aba ou solte aqui para exibir lado a lado" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Floating Interactive Text Box with Text Tools, Dotted Border, and Word Wrapping -->
                <Popup x:Name="PopupFloatingTextBox" 
                       AllowsTransparency="True" 
                       PlacementTarget="{Binding ElementName=CenterDocumentContainer}"
                       Placement="Center"
                       StaysOpen="True"
                       IsOpen="False">
                    <Grid Margin="10">
                        <StackPanel x:Name="FloatingBoxRoot">
                            <!-- 1. Text Tools Floating Header Toolbar -->
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" 
                                    Padding="8,5" Margin="0,0,0,6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.45" Color="Black" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Drag Handle -->
                                    <Border Grid.Column="0" x:Name="DragHandleBar" Background="#334155" CornerRadius="4" 
                                            Padding="6,3" Margin="0,0,8,0" Cursor="SizeAll"
                                            MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                                            MouseMove="DragHandle_MouseMove"
                                            MouseLeftButtonUp="DragHandle_MouseLeftButtonUp"
                                            ToolTip="Clique e arraste para posicionar a caixa sobre o documento">
                                        <TextBlock Text="⋮⋮ Mover" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Font Size Selector -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="🔤" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbFloatingFontSize" Width="55" Height="24" FontSize="11" 
                                                  Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"
                                                  SelectionChanged="CmbFloatingFontSize_SelectionChanged">
                                            <ComboBoxItem Content="10" />
                                            <ComboBoxItem Content="12" />
                                            <ComboBoxItem Content="14" />
                                            <ComboBoxItem Content="16" IsSelected="True" />
                                            <ComboBoxItem Content="18" />
                                            <ComboBoxItem Content="20" />
                                            <ComboBoxItem Content="24" />
                                            <ComboBoxItem Content="28" />
                                            <ComboBoxItem Content="32" />
                                            <ComboBoxItem Content="40" />
                                            <ComboBoxItem Content="48" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Color Selector -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button x:Name="BtnColorBlack" Width="18" Height="18" Margin="0,0,3,0" Background="#000000" 
                                                BorderBrush="#38BDF8" BorderThickness="2" Cursor="Hand" ToolTip="Preto" Click="BtnColor_Click" Tag="#000000">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9" /></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="BtnColorWhite" Width="18" Height="18" Margin="0,0,3,0" Background="#FFFFFF" 
                                                BorderBrush="#64748B" BorderThickness="1" Cursor="Hand" ToolTip="Branco" Click="BtnColor_Click" Tag="#FFFFFF">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9" /></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="BtnColorRed" Width="18" Height="18" Margin="0,0,3,0" Background="#EF4444" 
                                                BorderBrush="#64748B" BorderThickness="1" Cursor="Hand" ToolTip="Vermelho" Click="BtnColor_Click" Tag="#EF4444">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9" /></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="BtnColorBlue" Width="18" Height="18" Margin="0,0,3,0" Background="#2563EB" 
                                                BorderBrush="#64748B" BorderThickness="1" Cursor="Hand" ToolTip="Azul" Click="BtnColor_Click" Tag="#2563EB">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9" /></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="BtnColorYellow" Width="18" Height="18" Margin="0,0,3,0" Background="#EAB308" 
                                                BorderBrush="#64748B" BorderThickness="1" Cursor="Hand" ToolTip="Amarelo" Click="BtnColor_Click" Tag="#EAB308">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9" /></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>

                                    <!-- Formatting Bold & Italic -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ToggleButton x:Name="BtnFloatingBold" Content="B" Width="24" Height="24" Margin="0,0,3,0" 
                                                      FontWeight="ExtraBold" FontSize="11.5" Background="#0F172A" Foreground="#F8FAFC" 
                                                      BorderBrush="#334155" Cursor="Hand" ToolTip="Negrito" Click="BtnFloatingStyle_Click" />
                                        <ToggleButton x:Name="BtnFloatingItalic" Content="I" Width="24" Height="24" 
                                                      FontStyle="Italic" FontWeight="Bold" FontSize="11.5" Background="#0F172A" Foreground="#F8FAFC" 
                                                      BorderBrush="#334155" Cursor="Hand" ToolTip="Itálico" Click="BtnFloatingStyle_Click" />
                                    </StackPanel>

                                    <!-- Page Selector -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Pág:" FontSize="11" Foreground="#94A3B8" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbFloatingPage" Width="48" Height="24" FontSize="11" 
                                                  Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" />
                                    </StackPanel>

                                    <!-- Action Buttons: Apply & Close -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnApplyFloatingText" Content="✅ Inserir" Click="BtnApplyFloatingText_Click"
                                                Background="#10B981" Foreground="White" FontSize="11" FontWeight="Bold" 
                                                Padding="10,4" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand" ToolTip="Gravar texto no PDF">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5" /></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="BtnCloseFloatingText" Content="✕" Click="BtnCloseFloatingText_Click"
                                                Background="#334155" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" 
                                                Width="22" Height="22" BorderThickness="0" Cursor="Hand" ToolTip="Cancelar">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5" /></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2. The Dotted Transparent Resizable Text Box with Word Wrap -->
                            <Grid x:Name="BoxBorderContainer" Width="360" Height="120" MinWidth="180" MinHeight="60">
                                <!-- Dotted Border Background (Transparent fill, vibrant dashed outline) -->
                                <Rectangle Stroke="#38BDF8" StrokeThickness="1.8" StrokeDashArray="3 3" 
                                           RadiusX="4" RadiusY="4" Fill="#05000000" IsHitTestVisible="False" />

                                <!-- The Actual Text Box (Transparent, Wrapped) -->
                                <TextBox x:Name="TxtFloatingInput" 
                                         Background="Transparent" 
                                         Foreground="#000000" 
                                         BorderThickness="0" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True" 
                                         FontFamily="Arial" 
                                         FontSize="16" 
                                         CaretBrush="#38BDF8" 
                                         Padding="8" 
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Margin="2" />

                                <!-- Bottom-Right Resize Grip -->
                                <Thumb x:Name="ResizeThumb" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Grid Background="Transparent">
                                                <Path Data="M 12,2 L 12,12 L 2,12 Z" Fill="#38BDF8" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Popup>
            </Grid>

            <!-- Grid Splitter for Resizing Validation Panel -->
            <GridSplitter Grid.Column="3" x:Name="SplitterBar" Width="5" HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" Background="#1E293B" Cursor="SizeWE" Visibility="Collapsed" />

            <!-- ==================== RIGHT: VALIDATION & NOTEPAD PANEL ==================== -->
            <Border Grid.Column="4" x:Name="PanelNotepad" Background="#0A0F1D" 
                    BorderBrush="#1E293B" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <!-- Panel Header (Document Type & Score) -->
                        <RowDefinition Height="Auto" />
                        <!-- Import Verdict Banner -->
                        <RowDefinition Height="Auto" />
                        <!-- Diagnostics & Properties Area -->
                        <RowDefinition Height="Auto" />
                        <!-- Text Editor -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Status Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: Big Document Type + Integrity Badge -->
                    <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="CLASSIFICAÇÃO DO ARQUIVO" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtHeaderDocType" Text="Texto Vetorial Nativo" 
                                           FontSize="15" FontWeight="ExtraBold" Foreground="#10B981" 
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" x:Name="BadgeIntegrity" Background="#1E3A2F" BorderBrush="#10B981" BorderThickness="1" 
                                    CornerRadius="8" Padding="10,6" Margin="8,0,8,0" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtIntegrityScore" Text="100% Integridade" 
                                               FontSize="12" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtIntegrityStatusText" Text="Alta Integridade" 
                                               FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="2" Content="✕" Click="BtnCloseNotepad_Click"
                                    Width="26" Height="26" Background="Transparent" Foreground="#94A3B8" 
                                    BorderThickness="0" Cursor="Hand" ToolTip="Recolher Painel" />
                        </Grid>
                    </Border>

                    <!-- Import Verdict Banner -->
                    <Border Grid.Row="1" x:Name="BorderImportVerdict" Background="#1E3A2F" BorderBrush="#10B981" BorderThickness="1.5" 
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtImportVerdictIcon" Text="✅" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtImportVerdict" Text="O arquivo importa" 
                                       FontSize="13" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Expandable Properties & Diagnostics Section -->
                    <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                            CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtDiagStrangeChars" Text="Sinais Estranhos: 0" 
                                               FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtDiagFormatting" Text="Formatação: Bem Formatado" 
                                               FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtDiagImages" Text="Imagens / Scans: 0" 
                                               FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtDiagCharCount" Text="Total de Caracteres: 0" 
                                               FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtDiagWarning" Text="Texto analisado com alta integridade." 
                                       FontSize="11" Foreground="#60A5FA" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <Expander x:Name="ExpanderProps" Header="ℹ️ Propriedades do Documento" 
                                      Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,8">
                                <Border Background="#131D31" BorderBrush="#334155" BorderThickness="1" 
                                        CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tamanho:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtPropFileSize" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Versão PDF:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtPropPdfVersion" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Dimensões:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtPropDimensions" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Orientação:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPropOrientation" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Autor / Produtor:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtPropAuthorProducer" Text="-" Foreground="#E2E8F0" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Criação:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtPropCreationDate" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Segurança:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtPropSecurity" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />
                                    </Grid>
                                </Border>
                            </Expander>

                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="BtnToggleRawText" Content="Exibir Texto Cru" Click="BtnToggleRawText_Click"
                                        Background="#334155" Foreground="#F8FAFC" FontSize="11" FontWeight="Medium"
                                        Padding="8,5" Margin="0,0,6,4" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="📋 Copiar Tudo" Click="BtnCopyText_Click"
                                        Background="#334155" Foreground="#F8FAFC" FontSize="11" FontWeight="Medium"
                                        Padding="8,5" Margin="0,0,6,4" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="💾 Salvar .txt" Click="BtnSaveTxt_Click"
                                        Background="#334155" Foreground="#F8FAFC" FontSize="11" FontWeight="Medium"
                                        Padding="8,5" Margin="0,0,6,4" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                                    </Button.Resources>
                                </Button>

                                <Button x:Name="BtnToggleWrap" Content="Quebrar Linha: ON" Click="BtnToggleWrap_Click"
                                        Background="#334155" Foreground="#94A3B8" FontSize="11"
                                        Padding="8,5" Margin="0,0,0,4" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                                    </Button.Resources>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Text Editor -->
                    <Border Grid.Row="3" Background="#060A14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6">
                        <TextBox x:Name="TxtEditor" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="#E2E8F0" CaretBrush="#38BDF8"
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12.5"
                                 Padding="10" BorderThickness="0" TextChanged="TxtEditor_TextChanged" />
                    </Border>

                    <!-- Bottom Status Bar -->
                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtEditorStats" Text="Caracteres: 0 | Palavras: 0" 
                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />

                        <TextBlock x:Name="TxtEditorMode" Text="Modo: Layout Preservado" 
                                   Grid.Column="1" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== BANNER DISCRETO: LEITOR PADRÃO ==================== -->
        <Border x:Name="BannerDefaultApp" Grid.Row="1" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#0F172A" BorderBrush="#2563EB" BorderThickness="1.5"
                CornerRadius="8" Padding="14,8" Margin="20,0,20,14"
                Panel.ZIndex="999">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Data="M16 12V4H17V2H7V4H8V12L6 14V16H11V22H13V16H18V14L16 12Z" 
                      Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="Deseja definir o FT PDF como seu leitor padrão de PDF no Windows?" 
                           FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,16,0" />

                <Button Grid.Column="2" Content="OK, Definir como Padrão" Click="BtnSetDefaultBanner_Click"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="11.5"
                        Padding="12,5" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="3" Content="✕" Click="BtnDismissDefaultBanner_Click"
                        Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" FontSize="11"
                        BorderThickness="0" Cursor="Hand" ToolTip="Não perguntar novamente">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
