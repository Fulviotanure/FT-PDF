<Window x:Class="FtPdf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações - FT PDF" 
        Height="470" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        Icon="Assets/logo.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Border Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="FT PDF" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <Border Background="#1E3A2F" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtBadgeVersion" Text="Release 2.0.0" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Settings Content: Default App & Updates -->
            <StackPanel Grid.Row="1">
                <!-- Section 1: Default App Status & Configuration -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M16 12V4H17V2H7V4H8V12L6 14V16H11V22H13V16H18V14L16 12Z" 
                                      Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Leitor Padrão no Windows" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="BdDefaultStatus" Grid.Column="1" Background="#3F2E18" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconDefaultStatus" Data="M1 21H23L12 2L1 21ZM13 18H11V16H13V18ZM13 14H11V10H13V14Z" 
                                          Fill="#FBBF24" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtDefaultStatusBadge" Text="Verificando..." FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TxtDefaultStatusDescription" 
                                   Text="Configurar o FT PDF para abrir documentos PDF automaticamente com dois cliques." 
                                   FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <Button x:Name="BtnSetDefaultApp" Click="BtnSetDefaultApp_Click"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" FontSize="11.5"
                                Padding="12,6" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="5" /></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="IconSetDefaultBtn" Data="M19.14 12.94C19.18 12.63 19.2 12.32 19.2 12C19.2 11.68 19.18 11.37 19.14 11.06L21.41 9.29C21.62 9.13 21.67 8.83 21.54 8.6L19.4 4.9C19.27 4.67 18.99 4.58 18.75 4.68L16.08 5.76C15.52 5.33 14.9 4.98 14.23 4.71L13.83 1.87C13.8 1.61 13.57 1.42 13.31 1.42H9.03C8.77 1.42 8.54 1.61 8.51 1.87L8.11 4.71C7.44 4.98 6.82 5.33 6.26 5.76L3.59 4.68C3.35 4.58 3.07 4.67 2.94 4.9L0.8 8.6C0.67 8.83 0.72 9.13 0.93 9.29L3.2 11.06C3.16 11.37 3.14 11.68 3.14 12C3.14 12.32 3.16 12.63 3.2 12.94L0.93 14.71C0.72 14.87 0.67 15.17 0.8 15.4L2.94 19.1C3.07 19.33 3.35 19.42 3.59 19.32L6.26 18.24C6.82 18.67 7.44 19.02 8.11 19.29L8.51 22.13C8.54 22.39 8.77 22.58 9.03 22.58H13.31C13.57 22.58 13.8 22.39 13.83 22.13L14.23 19.29C14.9 19.02 15.52 18.67 16.08 18.24L18.75 19.32C18.99 19.42 19.27 19.33 19.4 19.1L21.54 15.4C21.67 15.17 21.62 14.87 21.41 14.71L19.14 12.94ZM11.17 15.5C9.24 15.5 7.67 13.93 7.67 12C7.67 10.07 9.24 8.5 11.17 8.5C13.1 8.5 14.67 10.07 14.67 12C14.67 13.93 13.1 15.5 11.17 15.5Z" 
                                      Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBtnSetDefaultApp" Text="Definir como Leitor Padrão" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Section 2: Updates -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4C9.11 4 6.6 5.64 5.35 8.04C2.34 8.36 0 10.91 0 14C0 17.31 2.69 20 6 20H19C21.76 20 24 17.76 24 15C24 12.36 21.95 10.22 19.35 10.04ZM13 13V17H11V13H8L12 9L16 13H13Z" 
                                  Fill="#38BDF8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Atualizações Contínuas" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Versão Instalada:" FontSize="11" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtCurrentVersion" Text="v2.0.0" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Última Versão:" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                <TextBlock x:Name="TxtLatestVersion" Text="Verificando..." FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtStatus" Text="Verificando atualizações..." FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,4" />
                        <ProgressBar x:Name="PbStatus" Height="3" IsIndeterminate="True" Margin="0,0,0,10" 
                                     Background="#0F172A" Foreground="#38BDF8" BorderThickness="0" />

                        <Button x:Name="BtnAction" Click="BtnAction_Click"
                                Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12"
                                Padding="14,7" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="5" /></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="IconBtnAction" Data="M17.65 6.35C16.2 4.9 14.21 4 12 4C7.58 4 4.01 7.58 4.01 12C4.01 16.42 7.58 20 12 20C15.73 20 18.84 17.45 19.73 14H17.65C16.83 16.33 14.61 18 12 18C8.69 18 6 15.31 6 12C6 8.69 8.69 6 12 6C13.66 6 15.14 6.69 16.22 7.78L13 11H20V4L17.65 6.35Z" 
                                      Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBtnAction" Text="Atualizar Agora" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom Button -->
            <Button Grid.Row="2" Content="Fechar" Click="BtnClose_Click"
                    Background="#334155" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"
                    Padding="16,6" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand" Margin="0,12,0,0">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5" /></Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
