<Window x:Class="FtPdfLite.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Documento Protegido por Senha" 
        Height="310" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Content / Form -->
                <RowDefinition Height="*" />
                <!-- Error Message -->
                <RowDefinition Height="Auto" />
                <!-- Footer Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Lock Icon & Title -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Amber Shield Lock Icon -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" 
                        Background="#261E0F" BorderBrush="#F59E0B" BorderThickness="1.2"
                        Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="M12 17C10.89 17 10 16.1 10 15C10 13.89 10.89 13 12 13C13.11 13 14 13.89 14 15C14 16.1 13.11 17 12 17ZM18 8H17V6C17 3.24 14.76 1 12 1C9.24 1 7 3.24 7 6V8H6C4.9 8 4 8.9 4 10V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V10C20 8.9 19.1 8 18 8ZM8.9 6C8.9 4.29 10.29 2.9 12 2.9C13.71 2.9 15.1 4.29 15.1 6V8H8.9V6Z"
                          Fill="#FBBF24" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Header Texts -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Documento Protegido" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock x:Name="TxtFileName" Text="arquivo.pdf" FontSize="12" Foreground="#94A3B8" 
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
            </Grid>

            <!-- Form Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Este arquivo PDF requer uma senha para ser aberto:" 
                           FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,8" />

                <!-- Input Box Container with Eye Button -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Masked Password -->
                        <PasswordBox x:Name="TxtPassword" Grid.Column="0" 
                                     Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"
                                     FontSize="13.5" Padding="8,6" VerticalContentAlignment="Center"
                                     CaretBrush="#38BDF8" KeyDown="Input_KeyDown" />

                        <!-- Plain Text (Shown when eye is toggled) -->
                        <TextBox x:Name="TxtPasswordVisible" Grid.Column="0" 
                                 Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"
                                 FontSize="13.5" Padding="8,6" VerticalContentAlignment="Center"
                                 CaretBrush="#38BDF8" Visibility="Collapsed" KeyDown="Input_KeyDown" />

                        <!-- Toggle Visibility (Eye) Button -->
                        <Button x:Name="BtnToggleEye" Grid.Column="1" Width="36" Height="32" 
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="Mostrar ou ocultar caracteres da senha"
                                Click="BtnToggleEye_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#334155" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Path x:Name="IconEye" Data="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z"
                                  Fill="#94A3B8" Stretch="Uniform" Width="17" Height="17" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Dynamic Error Feedback Panel -->
            <StackPanel x:Name="PanelError" Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8" Visibility="Collapsed">
                <TextBlock Text="⚠️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtErrorMessage" Text="Senha incorreta. Tente novamente." 
                           FontSize="11.5" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar" IsCancel="True" Click="BtnCancel_Click"
                        Background="#334155" Foreground="#F8FAFC" FontWeight="Medium"
                        Padding="18,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnUnlock" Content="Desbloquear" IsDefault="True" Click="BtnUnlock_Click"
                        Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                        Padding="22,8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
